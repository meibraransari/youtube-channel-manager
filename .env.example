# ==============================================================================
# YouTube Channel Manager - Environment Configuration Template (.env.example)
# Multi-Color Futuristic YouTube Content Management Platform
# ==============================================================================

# Node Environment & Server Ports
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Port Mapping (Customizable Host Port Mappings)
APP_PORT=3000
POSTGRES_EXTERNAL_PORT=5432

# PostgreSQL 18 Database Configuration
POSTGRES_HOST=postgres18
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_123
POSTGRES_DB=youtube_channel_manager_db

# Database Connection URL (used by backend application)
DATABASE_URL=postgresql://postgres:postgres_secure_pass_123@postgres18:5432/youtube_channel_manager_db

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_random_key_64_characters_min
JWT_EXPIRES_IN=7d

# Initial Admin Dashboard Credentials (auto-seeded on first run)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@2026
INITIAL_ADMIN_EMAIL=admin@devopsinaction.com
